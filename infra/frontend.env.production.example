# Copy to frontend/.env.production (not committed). Values come from the CloudFormation outputs.
VITE_DATA_MODE=api
VITE_API_BASE_URL=https://<cloudfront-domain>
VITE_COGNITO_DOMAIN=https://<prefix>.auth.<region>.amazoncognito.com
VITE_COGNITO_CLIENT_ID=<app client id>
VITE_COGNITO_REDIRECT_URI=https://<cloudfront-domain>/auth/callback
VITE_COGNITO_LOGOUT_URI=https://<cloudfront-domain>
