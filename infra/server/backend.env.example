# Copy to backend/.env on the server. Never commit the real file.
NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://lifetime:CHANGE_ME@localhost:5432/lifetime?schema=public
FRONTEND_ORIGIN=https://<cloudfront-domain>
UPLOAD_DIR=/home/ubuntu/uploads
ADMIN_EMAIL=admin@example.com
COGNITO_REGION=<region>
COGNITO_USER_POOL_ID=<user pool id>
COGNITO_CLIENT_ID=<app client id>
