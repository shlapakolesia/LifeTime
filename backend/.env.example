NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://lifetime:lifetime@localhost:5432/lifetime?schema=public
FRONTEND_ORIGIN=http://localhost:5173
# Explicitly opt in. Never use with real users or on a shared/public server.
DEV_IDENTITY_ENABLED=false
UPLOAD_DIR=./local-uploads
ADMIN_EMAIL=admin@lifetime.local
# Production auth (Amazon Cognito). All three or none. Leave empty for local dev identity.
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# AI assistant: none | mock (development only) | bedrock
AI_PROVIDER=none
# Required for bedrock, e.g. eu.anthropic.claude-haiku-4-5-20251001-v1:0 (credentials come from the AWS role, no keys)
BEDROCK_MODEL_ID=
AWS_REGION=eu-north-1
